// Firestore-beveiligingsregels van project ma-teamdashboard.
// Uitrollen: firebase deploy --only firestore:rules --project ma-teamdashboard
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{team}/info/{doc} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && doc == 'team' && team.size() >= 6 && team.size() <= 64;
    }
    match /teams/{team}/{col}/{doc} {
      allow read, update, delete: if request.auth != null && (col == 'taken' || col == 'contacten')
        && exists(/databases/$(database)/documents/teams/$(team)/info/team);
      allow create: if request.auth != null && (col == 'taken' || col == 'contacten')
        && exists(/databases/$(database)/documents/teams/$(team)/info/team)
        && request.resource.data.size() <= 20;
    }
    match /teams/{team}/tokens/{tok} {
      // apparaten melden zich aan voor pushmeldingen; lezen kan alleen het verzendscript (beheerrechten)
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/teams/$(team)/info/team)
        && request.resource.data.keys().hasOnly(['naam', 'bijgewerkt', 'apparaat'])
        && request.resource.data.naam is string && request.resource.data.naam.size() <= 40;
    }
    match /teams/{team}/king/{doc} {
      // KING-klantgegevens (geen omzet/marges); alleen lezen voor teamleden, schrijven doet alleen de functie kingSync
      allow read: if request.auth != null && exists(/databases/$(database)/documents/teams/$(team)/info/team);
    }
    match /teams/{team}/scores/{s} {
      // Spel (memory, sudoku): ranglijst van het team
      allow read: if request.auth != null && exists(/databases/$(database)/documents/teams/$(team)/info/team);
      allow create: if request.auth != null && exists(/databases/$(database)/documents/teams/$(team)/info/team)
        && request.resource.data.keys().hasOnly(['naam', 'tijd', 'zetten', 'datum', 'spel'])
        && (!('spel' in request.resource.data) || (request.resource.data.spel is string && request.resource.data.spel.size() <= 30))
        && request.resource.data.naam is string && request.resource.data.naam.size() <= 40
        && request.resource.data.tijd is number && request.resource.data.tijd >= 3000;
    }
  }
}